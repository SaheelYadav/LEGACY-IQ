# ==============================================================================
# LegacyIQ Backend Environment Configuration Template
# ==============================================================================
# Copy this file to backend/.env and replace placeholder values with your actual
# local infrastructure credentials from C:\LegacyIQ-infrastructure.
# NEVER commit backend/.env to version control.

APP_NAME=LegacyIQ
APP_ENV=development
APP_DEBUG=true

# PostgreSQL (Container: legacyiq-postgres, Image: pgvector/pgvector:pg17)
DATABASE_URL=postgresql+psycopg://legacyiq_admin:REPLACE_WITH_PASSWORD@localhost:5432/legacyiq

# Redis (Container: legacyiq-redis, Host Port: 6380 -> Container Port: 6379)
REDIS_URL=redis://:REPLACE_WITH_PASSWORD@localhost:6380/0

# Ollama Local Inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# Local Embeddings (Sentence Transformers)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu

# AI Provider Routing
AI_DEFAULT_PROVIDER=ollama
AI_FALLBACK_PROVIDER=openrouter

# Future / Fallback Cloud Providers (Optional — leave empty for local-first mode)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=cohere/north-mini-code:free

GEMINI_API_KEY=
GEMINI_MODEL=

GROQ_API_KEY=
GROQ_MODEL=

# CORS Allowed Origins (JSON list or comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

