# ==============================================================================
# LegacyIQ — Root Environment Configuration Template (Waves 1–7)
# ==============================================================================
# Copy this file to .env (or backend/.env) and fill in actual secret values.
# NEVER commit real .env files or credentials to version control.

# Application Settings
APP_NAME=LegacyIQ
APP_ENV=development
APP_DEBUG=true
LOG_FORMAT=text
LOG_LEVEL=INFO

# Cryptographic Signing & JWT Authentication
# CRITICAL (Production): Must be a unique high-entropy secret >= 32 characters
APP_SECRET_KEY=REPLACE_WITH_PASSWORD_MINIMUM_32_CHARACTERS_RANDOM_SECRET
AUTH_TOKEN_EXPIRE_MINUTES=60
AUTH_ENFORCE_BEARER_TOKEN=false

# PostgreSQL (Existing local infrastructure: legacyiq-postgres on port 5432)
DATABASE_URL=postgresql+psycopg://legacyiq_admin:REPLACE_WITH_PASSWORD@localhost:5432/legacyiq
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=3
DB_STATEMENT_TIMEOUT_MS=30000

# Redis (Existing local infrastructure: legacyiq-redis on host port 6380)
REDIS_URL=redis://:REPLACE_WITH_PASSWORD@localhost:6380/0
REDIS_CONNECT_TIMEOUT_SECONDS=3.0

# Tenant-Isolated Storage Vault & Archive Limits
STORAGE_VAULT_ROOT=./backend/storage_vault
MAX_ARCHIVE_COMPRESSED_MB=50
MAX_ARCHIVE_UNCOMPRESSED_MB=150
MAX_ARCHIVE_FILE_COUNT=2500

# Ollama Local Inference (Existing local service on port 11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_SECONDS=5.0

# Local Embeddings (Sentence Transformers)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu

# AI Provider Routing
AI_DEFAULT_PROVIDER=ollama
AI_FALLBACK_PROVIDER=openrouter

# Optional Future Cloud Providers (Leave blank for local-first operation)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=cohere/north-mini-code:free

GEMINI_API_KEY=
GEMINI_MODEL=

GROQ_API_KEY=
GROQ_MODEL=

# Security: CORS, Trusted Hosts & Rate Limiting
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_EXPENSIVE_PER_MINUTE=20


