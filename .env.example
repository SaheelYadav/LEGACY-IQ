# ==============================================================================
# LegacyIQ — Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or backend/.env) and fill in actual secret values.
# NEVER commit real .env files or credentials to version control.

# Application Settings
APP_NAME=LegacyIQ
APP_ENV=development
APP_DEBUG=true

# PostgreSQL (Existing local infrastructure: legacyiq-postgres on port 5432)
DATABASE_URL=postgresql+psycopg://legacyiq_admin:REPLACE_WITH_PASSWORD@localhost:5432/legacyiq

# Redis (Existing local infrastructure: legacyiq-redis on host port 6380)
REDIS_URL=redis://:REPLACE_WITH_PASSWORD@localhost:6380/0

# Ollama Local Inference (Existing local service on port 11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# Local Embeddings (Sentence Transformers)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu

# AI Provider Routing
AI_DEFAULT_PROVIDER=ollama
AI_FALLBACK_PROVIDER=openrouter

# Optional Future Cloud Providers (Leave blank for local-first operation)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=cohere/north-mini-code:free

GEMINI_API_KEY=
GEMINI_MODEL=

GROQ_API_KEY=
GROQ_MODEL=

# Frontend / Backend URLs
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

